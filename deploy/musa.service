[Unit]
Description=Musa Ledger (loan.khanmusa.com)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/musa
EnvironmentFile=/opt/musa/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=DATABASE_PATH=/opt/musa/data/musa.db
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
