# Secret used to sign login sessions (generate a long random string)
AUTH_SECRET=change-me-to-a-long-random-secret

# First admin account (created automatically on first start)
ADMIN_USERNAME=ammad
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME="Ammad Khan"

# Optional: absolute path for SQLite database file
# DATABASE_PATH=/data/musa.db

# Public site URL (used in docs / redirects)
NEXT_PUBLIC_APP_URL=https://loan.khanmusa.com

# --- Notifications (optional) ---
# Prefer free WhatsApp via CallMeBot (per-user phone + API key on People page).
# If WhatsApp is missing/fails, email is used when SMTP is configured below.
#
# CallMeBot setup (free): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1) Save bot contact, send the activation message, get your apikey
# 2) On People → Edit member → paste phone (+92...) and API key
#
# Email fallback (Gmail example — use an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Loan <you@gmail.com>"
