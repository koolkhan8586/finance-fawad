# Secret used to sign login sessions (generate a long random string)
AUTH_SECRET=change-me-to-a-long-random-secret

# First admin account (created automatically on first start)
ADMIN_USERNAME=ammad
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME="Ammad Khan"

# Optional: absolute path for SQLite database file
# DATABASE_PATH=/data/musa.db

# Public site URL (used in docs / redirects)
NEXT_PUBLIC_APP_URL=https://loan.khanmusa.com

# --- WhatsApp alerts (preference order: WAHA → TextMeBot → email) ---

# 1) WAHA (recommended if you self-host WhatsApp HTTP API)
# Docs: https://waha.devlike.pro/docs/how-to/send-messages/
# WAHA_URL=http://127.0.0.1:3001
# WAHA_API_KEY=your-waha-api-key
# WAHA_SESSION=default
#
# Then on People page, set each person's WhatsApp phone as +92300...
# Loan will POST /api/sendText with chatId like 92300...@c.us

# 2) TextMeBot fallback (optional)
# TEXTMEBOT_APIKEY=

# 3) Email fallback if WhatsApp fails / phone missing:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Loan <you@gmail.com>"
